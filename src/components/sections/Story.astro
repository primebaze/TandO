---

---

<section id="story" class="relative overflow-hidden bg-[var(--color-ivory)] py-32" data-animate="story">
  <div class="mx-auto max-w-5xl px-6">
    <div class="text-center">
      <p class="section-reveal font-sans text-[10px] uppercase tracking-[0.4em] text-[var(--color-gold)] opacity-0">Our Journey</p>
      <h2
        class="section-reveal mt-3 font-serif text-4xl font-semibold text-[var(--color-charcoal)] opacity-0 md:text-5xl"
      >
        How It All Began
      </h2>
    </div>
    <div class="mt-20 space-y-24 md:space-y-32">
      <div class="story-block flex flex-col items-center gap-8 opacity-0 md:gap-16 md:flex-row">
        <div class="story-image w-full overflow-hidden rounded-3xl shadow-xl md:w-1/2">
          <img
            src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&q=80"
            alt="First Meeting"
            class="aspect-[4/3] h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="story-text w-full md:w-1/2 md:pl-4">
          <span class="font-[family-name:var(--font-family-script)] text-5xl text-[var(--color-gold)]">2019</span>
          <h3 class="mt-2 font-serif text-2xl font-semibold text-[var(--color-charcoal)] md:text-3xl">First Meeting</h3>
          <div class="my-4 h-px w-12 bg-[var(--color-gold-light)]/40"></div>
          <p class="font-sans text-sm leading-relaxed text-gray-500 md:text-base">A chance encounter at a coffee shop downtown. Little did we know this would change everything.</p>
        </div>
      </div>
      <div class="story-block flex flex-col items-center gap-8 opacity-0 md:gap-16 md:flex-row-reverse">
        <div class="story-image w-full overflow-hidden rounded-3xl shadow-xl md:w-1/2">
          <img
            src="https://images.unsplash.com/photo-1529543544282-ea4407407e9f?w=600&q=80"
            alt="First Date"
            class="aspect-[4/3] h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="story-text w-full md:w-1/2 md:pr-4">
          <span class="font-[family-name:var(--font-family-script)] text-5xl text-[var(--color-gold)]">2020</span>
          <h3 class="mt-2 font-serif text-2xl font-semibold text-[var(--color-charcoal)] md:text-3xl">First Date</h3>
          <div class="my-4 h-px w-12 bg-[var(--color-gold-light)]/40"></div>
          <p class="font-sans text-sm leading-relaxed text-gray-500 md:text-base">Dinner under the stars. We talked for hours and knew this was something special.</p>
        </div>
      </div>
      <div class="story-block flex flex-col items-center gap-8 opacity-0 md:gap-16 md:flex-row">
        <div class="story-image w-full overflow-hidden rounded-3xl shadow-xl md:w-1/2">
          <img
            src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&q=80"
            alt="Moving In"
            class="aspect-[4/3] h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="story-text w-full md:w-1/2 md:pl-4">
          <span class="font-[family-name:var(--font-family-script)] text-5xl text-[var(--color-gold)]">2022</span>
          <h3 class="mt-2 font-serif text-2xl font-semibold text-[var(--color-charcoal)] md:text-3xl">Moving In</h3>
          <div class="my-4 h-px w-12 bg-[var(--color-gold-light)]/40"></div>
          <p class="font-sans text-sm leading-relaxed text-gray-500 md:text-base">We took the leap and built our first home together. Every day became an adventure.</p>
        </div>
      </div>
      <div class="story-block flex flex-col items-center gap-8 opacity-0 md:gap-16 md:flex-row-reverse">
        <div class="story-image w-full overflow-hidden rounded-3xl shadow-xl md:w-1/2">
          <img
            src="https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?w=600&q=80"
            alt="The Proposal"
            class="aspect-[4/3] h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="story-text w-full md:w-1/2 md:pr-4">
          <span class="font-[family-name:var(--font-family-script)] text-5xl text-[var(--color-gold)]">2025</span>
          <h3 class="mt-2 font-serif text-2xl font-semibold text-[var(--color-charcoal)] md:text-3xl">The Proposal</h3>
          <div class="my-4 h-px w-12 bg-[var(--color-gold-light)]/40"></div>
          <p class="font-sans text-sm leading-relaxed text-gray-500 md:text-base">A sunset walk along the beach, the question was asked, and the answer was yes!</p>
        </div>
      </div>
    </div>
  </div>
</section>
