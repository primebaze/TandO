---
/**
 * Arched hero (new-hero redesign).
 * Full-bleed image with a domed maroon base that curves up into the photo,
 * transitioning into the page. Eyebrow + script title + subtitle over the image.
 */
interface Props {
  src?: string;
  video?: string;
  poster?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const { src, video, poster, eyebrow, title, subtitle } = Astro.props;
---

<section
  class="arch-hero relative isolate flex min-h-[92svh] flex-col overflow-hidden bg-[#4a2826]"
>
  {/* Background media — video or image */}
  {
    video ? (
      <video
        class="arch-hero-media absolute inset-0 z-0 h-full w-full object-cover"
        src={video}
        poster={poster}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      />
    ) : (
      <img
        src={src}
        alt=""
        aria-hidden="true"
        class="arch-hero-media arch-ken absolute inset-0 z-0 h-full w-full object-cover"
      />
    )
  }

  {/* Legibility overlays */}
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-b from-black/45 via-black/20 to-[#4a2826]/70"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(ellipse_at_center,transparent_38%,rgba(0,0,0,0.5)_96%)]"
    aria-hidden="true"
  >
  </div>

  {/* Domed maroon base — curves up into the photo */}
  <svg
    class="pointer-events-none absolute bottom-0 left-0 z-[5] h-[clamp(150px,19vw,250px)] w-full"
    viewBox="0 0 1440 260"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path d="M0,260 L0,58 Q720,282 1440,58 L1440,260 Z" fill="#4a2826"></path>
  </svg>

  {/* Content */}
  <div
    class="relative z-10 mx-auto flex w-full max-w-3xl flex-1 flex-col items-center justify-center px-6 pb-[15vh] text-center text-white"
  >
    {
      eyebrow && (
        <p class="hero-rise hero-rise--1 inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/[0.06] px-5 py-1.5 font-sans text-[10px] font-semibold uppercase tracking-[0.42em] text-white/85 backdrop-blur-md">
          <span class="h-1 w-1 rounded-full bg-[#e6c787]" />
          {eyebrow}
          <span class="h-1 w-1 rounded-full bg-[#e6c787]" />
        </p>
      )
    }
    <h1
      class="hero-rise hero-rise--2 mt-7 text-[clamp(3rem,9vw,6rem)] font-normal leading-[0.9] drop-shadow-[0_4px_30px_rgba(0,0,0,0.6)]"
      style="font-family: var(--font-family-script), 'Great Vibes', cursive;"
      set:html={title}
    />
    {
      subtitle && (
        <p class="hero-rise hero-rise--3 mx-auto mt-6 max-w-xl font-serif text-[clamp(1.05rem,2.4vw,1.35rem)] font-light italic leading-relaxed text-white/85">
          {subtitle}
        </p>
      )
    }
  </div>

  {/* Scroll cue */}
  <div
    class="hero-rise hero-rise--3 pointer-events-none absolute bottom-6 left-1/2 z-10 -translate-x-1/2"
    aria-hidden="true"
  >
    <span
      class="flex h-9 w-5 items-start justify-center rounded-full border border-[#e6c787]/45 p-1"
    >
      <span class="arch-scroll-dot h-1.5 w-1.5 rounded-full bg-[#e6c787]/80"></span>
    </span>
  </div>
</section>

<style>
  .arch-ken {
    animation: archKen 22s ease-in-out infinite alternate;
  }
  @keyframes archKen {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.11);
    }
  }

  .hero-rise {
    opacity: 0;
    transform: translateY(22px);
    animation: heroRise 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-rise--1 {
    animation-delay: 0.15s;
  }
  .hero-rise--2 {
    animation-delay: 0.4s;
  }
  .hero-rise--3 {
    animation-delay: 0.75s;
  }
  @keyframes heroRise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .arch-scroll-dot {
    animation: archScroll 1.8s ease-in-out infinite;
  }
  @keyframes archScroll {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-ken,
    .hero-rise,
    .arch-scroll-dot {
      animation: none;
    }
    .hero-rise {
      opacity: 1;
      transform: none;
    }
  }
</style>
