---
/**
 * Pinned GTA-VI-style zoom sequence.
 * A maroon curtain with a Moroccan-arch window pins to the viewport. On
 * scroll, the camera zooms IN through the arch until the image fills the
 * screen (content revealed + caption), holds, then zooms back OUT to the
 * curtain — then the next image takes the window and it repeats.
 * Reusable via `beats`.
 */
interface Beat {
  image: string;
  eyebrow?: string;
  title: string;
  text?: string;
}
interface Props {
  beats: Beat[];
  footerLabel?: string;
}
const { beats, footerLabel = "Your journey begins" } = Astro.props;
// Scroll room: each beat gets ~1.1 viewports (zoom in, hold, zoom out).
const heightVh = Math.round(beats.length * 115 + 60);
---

<section
  class="arch-scroll relative w-full bg-[#4a2826]"
  style={`height:${heightVh}vh`}
>
  <div class="as-pin sticky top-0 h-[100svh] w-full overflow-hidden bg-[#4a2826]">
    <svg
      class="absolute inset-0 h-full w-full"
      viewBox="0 0 1000 1000"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <clipPath id="as-window" clipPathUnits="userSpaceOnUse">
          {/* Capsule window (img1) — scales up to swallow the viewport (zoom-in) */}
          <path
            class="as-window-path"
            d="M205,405 Q205,110 500,110 Q795,110 795,405 L795,595 Q795,890 500,890 Q205,890 205,595 Z"
          ></path>
        </clipPath>
      </defs>
      <g clip-path="url(#as-window)">
        {
          beats.map((b, i) => (
            <image
              class="as-img"
              data-i={i}
              href={b.image}
              x="0"
              y="0"
              width="1000"
              height="1000"
              preserveAspectRatio="xMidYMid slice"
              opacity={i === 0 ? 1 : 0}
            />
          ))
        }
        <rect
          class="as-dim"
          width="1000"
          height="1000"
          fill="#000000"
          opacity="0.3"></rect>
      </g>
    </svg>

    {/* Captions — appear while zoomed in (content full-screen) */}
    <div class="pointer-events-none absolute inset-0">
      {
        beats.map((b, i) => (
          <figcaption
            class="as-cap absolute inset-x-0 bottom-[12%] px-6 text-center text-white"
            data-i={i}
            style="opacity:0"
          >
            {b.eyebrow && (
              <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.42em] text-[#e6c787]/85">
                {b.eyebrow}
              </p>
            )}
            <p
              class="mt-3 text-[clamp(2.2rem,6vw,4rem)] leading-[0.95] drop-shadow-[0_4px_24px_rgba(0,0,0,0.65)]"
              style="font-family: var(--font-family-script), 'Great Vibes', cursive;"
            >
              {b.title}
            </p>
            {b.text && (
              <p class="mx-auto mt-3 max-w-md font-serif text-base italic leading-relaxed text-white/85">
                {b.text}
              </p>
            )}
          </figcaption>
        ))
      }
    </div>

    {/* Footer label — rises on the final zoom-out */}
    <p
      class="as-footer pointer-events-none absolute inset-x-0 bottom-[10%] text-center font-[family-name:var(--font-family-script)] text-4xl text-[#e6c787] md:text-5xl"
      style="opacity:0"
    >
      {footerLabel}
    </p>
  </div>
</section>

<style>
  .as-window-path,
  .as-img {
    will-change: transform;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>(".arch-scroll").forEach((section) => {
    const path = section.querySelector<SVGPathElement>(".as-window-path");
    const dim = section.querySelector<SVGRectElement>(".as-dim");
    const imgs = gsap.utils.toArray<SVGImageElement>(section.querySelectorAll(".as-img"));
    const caps = gsap.utils.toArray<HTMLElement>(section.querySelectorAll(".as-cap"));
    const footer = section.querySelector<HTMLElement>(".as-footer");
    if (!path || !imgs.length) return;

    // SVG-space transform origins (user units) — reliable for clip-path
    // children where CSS transform-origin is not.
    const WIN_ORIGIN = "500 500";
    const IMG_ORIGIN = "500 500";

    if (reduce) {
      gsap.set(path, { scale: 9, svgOrigin: WIN_ORIGIN });
      if (caps[0]) gsap.set(caps[0], { autoAlpha: 1 });
      return;
    }

    const tl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom bottom",
        scrub: 0.6,
      },
    });

    imgs.forEach((img, i) => {
      // Swap in this beat's image behind the closed curtain.
      if (i > 0) {
        tl.set(imgs[i - 1], { opacity: 0 });
        tl.set(img, { opacity: 1 });
      }

      // ZOOM IN — the arch window scales up past the viewport, camera pushes
      // through it; the image settles from a push-in as it fills the screen.
      tl.fromTo(
        path,
        { scale: 1, svgOrigin: WIN_ORIGIN },
        { scale: 9, svgOrigin: WIN_ORIGIN, duration: 1, ease: "power2.in" },
      );
      tl.fromTo(
        img,
        { scale: 1.3, svgOrigin: IMG_ORIGIN },
        { scale: 1.05, svgOrigin: IMG_ORIGIN, duration: 1, ease: "power1.inOut" },
        "<",
      );
      if (dim) tl.fromTo(dim, { opacity: 0.3 }, { opacity: 0, duration: 0.6 }, "<0.3");

      // Caption fades in once we're through the arch.
      if (caps[i]) tl.fromTo(caps[i], { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 0.35, ease: "power2.out" }, ">-0.25");

      const last = i === imgs.length - 1;

      // HOLD — full-screen content (longer on the last beat before releasing).
      tl.to({}, { duration: last ? 0.9 : 0.45 });

      // ZOOM OUT only BETWEEN beats. The last beat stays full-screen and the
      // pin simply releases — the page scrolls straight on (no snap back).
      if (!last) {
        if (caps[i]) tl.to(caps[i], { autoAlpha: 0, y: -18, duration: 0.3 });
        tl.to(path, { scale: 1, svgOrigin: WIN_ORIGIN, duration: 0.9, ease: "power2.out" }, "<");
        tl.to(img, { scale: 1.3, svgOrigin: IMG_ORIGIN, duration: 0.9, ease: "power1.inOut" }, "<");
        if (dim) tl.to(dim, { opacity: 0.3, duration: 0.5 }, "<0.2");
      }
    });
  });

  window.addEventListener("load", () => ScrollTrigger.refresh());
</script>
