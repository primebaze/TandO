---
/**
 * Pinned GSAP + MorphSVG scroll sequence.
 * A maroon "curtain" window (SVG clip path) MORPHS through the keyframe shapes
 * as you scroll — pill -> arch -> dome -> open — revealing each content image
 * behind it (with a zoom), then opens to a footer band. Reusable via `beats`.
 */
interface Beat {
  image: string;
  eyebrow?: string;
  title: string;
  text?: string;
}
interface Props {
  beats: Beat[];
  footerLabel?: string;
}
const { beats, footerLabel = "Your journey begins" } = Astro.props;
// Scroll room: intro + each beat + footer.
const heightVh = (beats.length + 2) * 100;
---

<section
  class="arch-scroll relative w-full bg-[#4a2826]"
  style={`height:${heightVh}vh`}
>
  <div class="as-pin sticky top-0 h-[100svh] w-full overflow-hidden bg-[#4a2826]">
    <svg
      class="absolute inset-0 h-full w-full"
      viewBox="0 0 1000 1000"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <clipPath id="as-window" clipPathUnits="userSpaceOnUse">
          <path
            class="as-window-path"
            d="M440,480 Q440,450 500,450 Q560,450 560,480 L560,520 Q560,550 500,550 Q440,550 440,520 Z"
          ></path>
        </clipPath>
      </defs>
      <g clip-path="url(#as-window)">
        {
          beats.map((b, i) => (
            <image
              class="as-img"
              data-i={i}
              href={b.image}
              x="0"
              y="0"
              width="1000"
              height="1000"
              preserveAspectRatio="xMidYMid slice"
              opacity={i === 0 ? 1 : 0}
            />
          ))
        }
        <rect width="1000" height="1000" fill="#000000" opacity="0.28"></rect>
      </g>
    </svg>

    {/* Captions — fade per beat, over the revealed window */}
    <div
      class="pointer-events-none absolute inset-x-0 bottom-[16%] flex flex-col items-center px-6 text-center text-white"
    >
      {
        beats.map((b, i) => (
          <figcaption
            class="as-cap absolute inset-x-0 px-6"
            data-i={i}
            style={i === 0 ? "opacity:1" : "opacity:0"}
          >
            {b.eyebrow && (
              <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.42em] text-[#e6c787]/85">
                {b.eyebrow}
              </p>
            )}
            <p
              class="mt-3 text-[clamp(2.2rem,6vw,4rem)] leading-[0.95] drop-shadow-[0_4px_24px_rgba(0,0,0,0.65)]"
              style="font-family: var(--font-family-script), 'Great Vibes', cursive;"
            >
              {b.title}
            </p>
            {b.text && (
              <p class="mx-auto mt-3 max-w-md font-serif text-base italic leading-relaxed text-white/85">
                {b.text}
              </p>
            )}
          </figcaption>
        ))
      }
    </div>

    {/* Footer label — rises as the curtain opens */}
    <p
      class="as-footer pointer-events-none absolute inset-x-0 bottom-[10%] text-center font-[family-name:var(--font-family-script)] text-4xl text-[#e6c787] md:text-5xl"
      style="opacity:0"
    >
      {footerLabel}
    </p>
  </div>
</section>

<style>
  .as-img {
    transform-box: view-box;
    transform-origin: center;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { MorphSVGPlugin } from "gsap/MorphSVGPlugin";

  gsap.registerPlugin(ScrollTrigger, MorphSVGPlugin);

  // Keyframe window shapes (userSpace 0-1000, stretched to the viewport).
  const SHAPES = {
    dot: "M440,480 Q440,450 500,450 Q560,450 560,480 L560,520 Q560,550 500,550 Q440,550 440,520 Z",
    pill: "M350,360 Q350,190 500,190 Q650,190 650,360 L650,640 Q650,810 500,810 Q350,810 350,640 Z",
    arch: "M260,440 Q260,170 500,170 Q740,170 740,440 L740,830 L260,830 Z",
    dome: "M120,520 Q120,230 500,230 Q880,230 880,520 L880,870 L120,870 Z",
    open: "M0,0 L1000,0 L1000,730 L0,730 Z",
  };
  const SEQ = [SHAPES.pill, SHAPES.arch, SHAPES.dome];

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>(".arch-scroll").forEach((section) => {
    const path = section.querySelector<SVGPathElement>(".as-window-path");
    const imgs = gsap.utils.toArray<SVGImageElement>(section.querySelectorAll(".as-img"));
    const caps = gsap.utils.toArray<HTMLElement>(section.querySelectorAll(".as-cap"));
    const footer = section.querySelector<HTMLElement>(".as-footer");
    if (!path || !imgs.length) return;

    if (reduce) {
      gsap.set(path, { morphSVG: SHAPES.dome });
      return;
    }

    const tl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom bottom",
        scrub: 0.6,
      },
    });

    imgs.forEach((img, i) => {
      const shape = SEQ[Math.min(i, SEQ.length - 1)];

      // Cross-fade to this beat's image + caption.
      if (i > 0) {
        tl.to(imgs[i - 1], { opacity: 0, duration: 0.5 });
        tl.to(img, { opacity: 1, duration: 0.5 }, "<");
        if (caps[i - 1]) tl.to(caps[i - 1], { autoAlpha: 0, duration: 0.4 }, "<");
      }
      // Morph the window open to this beat's shape + zoom the image in.
      tl.to(path, { morphSVG: shape, duration: 1, ease: "power2.inOut" }, i ? "<" : 0);
      tl.fromTo(img, { scale: 1.28 }, { scale: 1, duration: 1.1 }, "<");
      if (caps[i]) tl.fromTo(caps[i], { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.5 }, "<0.2");

      // Hold on the revealed content.
      tl.to({}, { duration: 0.5 });
    });

    // Final: last caption out, curtain opens fully, footer rises.
    if (caps.length) tl.to(caps[caps.length - 1], { autoAlpha: 0, duration: 0.4 });
    tl.to(path, { morphSVG: SHAPES.open, duration: 1, ease: "power3.inOut" }, "<");
    tl.to(imgs[imgs.length - 1], { scale: 1.12, duration: 1 }, "<");
    if (footer) tl.fromTo(footer, { autoAlpha: 0, y: 28 }, { autoAlpha: 1, y: 0, duration: 0.6 }, "<0.3");
  });

  window.addEventListener("load", () => ScrollTrigger.refresh());
</script>
