---

---

<section
  id="dresscode"
  class="relative overflow-hidden bg-[#fffaf0] py-20 md:py-28"
  data-animate="dresscode"
  data-section-title="Dress Code"
>
  <div class="mx-auto max-w-2xl px-6 text-center">
    <p
      class="section-reveal font-sans text-[10px] uppercase tracking-[0.4em] text-[var(--color-gold)] opacity-0"
    >
      Celebrate in Style
    </p>
    <h2
      class="section-reveal mt-3 font-serif text-4xl font-semibold text-[var(--color-charcoal)] opacity-0 md:text-5xl"
    >
      Formal Attire
    </h2>

    <div class="dresscode-card relative mx-auto mt-12 max-w-sm opacity-0 md:max-w-md">
      <img
        src="/assets/footer-ornament.png"
        alt=""
        aria-hidden="true"
        class="w-full"
      />
      <!-- Content centred inside the arch opening -->
      <div class="absolute inset-0 flex flex-col items-center justify-center px-10 pt-[28%] pb-[12%]">
        <p class="font-serif text-sm leading-relaxed text-[#5d574a] md:text-base">
          We kindly ask you to dress formally as we celebrate this special week together.
        </p>
        <div class="mx-auto my-4 h-px w-12 bg-[var(--color-gold-light)]/50"></div>
        <p class="font-sans text-[11px] italic text-gray-400">
          Please avoid wearing white — it is reserved for the bride.
        </p>
      </div>
    </div>
  </div>
</section>
