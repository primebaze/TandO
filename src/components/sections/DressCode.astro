---

---

<section id="dresscode" class="relative overflow-hidden bg-white py-32" data-animate="dresscode">
  <div class="mx-auto max-w-2xl px-6 text-center">
    <p class="section-reveal font-sans text-[10px] uppercase tracking-[0.4em] text-[var(--color-gold)] opacity-0">A Few Gentle Reminders</p>
    <h2
      class="section-reveal mt-3 font-serif text-4xl font-semibold text-[var(--color-charcoal)] opacity-0 md:text-5xl"
    >
      Dress Code
    </h2>
    <div class="dresscode-card mt-14 rounded-3xl border border-gray-100 bg-[var(--color-blush)] p-10 opacity-0 shadow-sm md:p-14">
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-white shadow-sm">
        <svg class="h-10 w-10 text-[var(--color-gold)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342"
          />
        </svg>
      </div>
      <h3 class="mt-6 font-serif text-2xl font-semibold text-[var(--color-charcoal)]">Semi-Formal Attire</h3>
      <p class="mx-auto mt-4 max-w-md font-sans text-sm leading-relaxed text-gray-500">
        We kindly ask you to dress in semi-formal or garden chic attire to join us on this very special day.
      </p>
      <div class="mx-auto my-6 h-px w-16 bg-[var(--color-gold-light)]/30"></div>
      <p class="font-sans text-xs italic text-gray-400">Please avoid wearing white — it is reserved for the bride.</p>
    </div>
  </div>
</section>
