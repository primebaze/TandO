---

---

<section
  id="dresscode"
  class="relative overflow-hidden bg-[#fffaf0] py-20 md:py-28"
  data-animate="dresscode"
  data-section-title="Dress Code"
>
  <div class="mx-auto max-w-2xl px-6 text-center">
    <div class="dresscode-card relative mx-auto max-w-sm opacity-0 md:max-w-md">
      <img
        src="/assets/footer-ornament.png"
        alt=""
        aria-hidden="true"
        class="w-full"
      />
      <!-- Content sits low inside the open doorway -->
      <div class="absolute inset-0 flex flex-col items-center justify-end px-10 pb-[14%]">
        <p
          class="font-[family-name:var(--font-family-script)] text-4xl text-[var(--color-gold)] md:text-5xl"
        >
          T &amp; O
        </p>
        <div class="mx-auto my-4 h-px w-10 bg-[var(--color-gold)]/40"></div>
        <a
          href="/rsvp"
          class="inline-flex items-center justify-center rounded-full border border-[var(--color-gold)] bg-white/70 px-6 py-2 font-serif text-xs uppercase tracking-[0.22em] text-[#4b3926] shadow-[0_8px_24px_rgba(90,50,26,0.10)] transition duration-300 hover:-translate-y-0.5 hover:bg-white"
        >
          Join us in Marrakech
        </a>
      </div>
    </div>
  </div>
</section>
