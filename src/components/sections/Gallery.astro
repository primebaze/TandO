---

---

<section
  id="gallery"
  class="bg-[var(--color-ivory)] py-32"
  data-animate="gallery"
  data-section-title="Moments"
>
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center">
      <p
        class="section-reveal font-sans text-[10px] uppercase tracking-[0.4em] text-[var(--color-gold)] opacity-0"
      >
        Moments
      </p>
      <h2
        class="section-reveal mt-3 font-serif text-4xl font-semibold text-[var(--color-charcoal)] opacity-0 md:text-5xl"
      >
        Guest-facing media
      </h2>
      <p
        class="section-reveal mx-auto mt-4 max-w-xl font-serif text-lg leading-relaxed text-[#5d574a]/80 opacity-0"
      >
        A place for memories from Marrakesh as the celebration unfolds.
      </p>
    </div>
    <div class="mt-16 columns-1 gap-4 sm:columns-2 lg:columns-3">
      {
        [
          {
            src: "https://images.unsplash.com/photo-1606216794074-735e91aa2c92?w=600&q=80",
            alt: "Photo 1",
            aspect: "aspect-[3/4]",
          },
          {
            src: "https://images.unsplash.com/photo-1583939003579-730e3918a45a?w=600&q=80",
            alt: "Photo 2",
            aspect: "aspect-[4/3]",
          },
          {
            src: "https://images.unsplash.com/photo-1520854221256-17451cc331bf?w=600&q=80",
            alt: "Photo 3",
            aspect: "aspect-[4/3]",
          },
          {
            src: "https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=600&q=80",
            alt: "Photo 4",
            aspect: "aspect-[3/4]",
          },
          {
            src: "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=600&q=80",
            alt: "Photo 5",
            aspect: "aspect-[4/3]",
          },
          {
            src: "https://images.unsplash.com/photo-1519741497674-611481863552?w=600&q=80",
            alt: "Photo 6",
            aspect: "aspect-[4/3]",
          },
        ].map((p) => (
          <div class="gallery-item mb-4 break-inside-avoid overflow-hidden rounded-2xl opacity-0">
            <img
              src={p.src}
              alt={p.alt}
              class={`w-full object-cover transition-transform duration-700 hover:scale-105 ${p.aspect}`}
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
