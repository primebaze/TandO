---
import ScratchHearts from '../react/ScratchHearts';
---

<section id="hero" class="hero-section relative min-h-screen overflow-hidden bg-[#120b08] text-white">
  <div
    class="hero-bg absolute inset-0 scale-[1.04] bg-cover bg-center opacity-0 will-change-transform"
    style="background-image: url('/images/hero.jpeg');"
    aria-hidden="true"
  />
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(38,18,10,0.10)_0%,rgba(10,5,3,0.52)_72%),linear-gradient(180deg,rgba(11,7,5,0.26)_0%,rgba(11,7,5,0.12)_38%,rgba(11,7,5,0.66)_100%)]" aria-hidden="true" />
  <div class="hero-grain pointer-events-none absolute inset-0 z-[1] opacity-0 mix-blend-overlay will-change-transform" />
  <div class="hero-water pointer-events-none absolute inset-x-0 bottom-0 z-[2] h-[36vh] opacity-60" aria-hidden="true" />

  <div class="hero-arch pointer-events-none absolute left-1/2 top-[8vh] z-[3] h-[58vh] w-[min(72vw,520px)] -translate-x-1/2 opacity-0" aria-hidden="true">
    <div class="h-full w-full rounded-t-[999px] border border-[#f5d391]/22 shadow-[inset_0_0_0_1px_rgba(255,245,220,0.08),0_0_80px_rgba(255,164,76,0.12)]" />
  </div>

  <div class="hero-lantern hero-lantern-left pointer-events-none absolute left-[7%] top-[13%] z-[4] hidden md:block" aria-hidden="true">
    <div class="lantern-chain" />
    <div class="lantern-body">
      <span class="lantern-glow" />
    </div>
  </div>
  <div class="hero-lantern hero-lantern-right pointer-events-none absolute right-[8%] top-[15%] z-[4] hidden md:block" aria-hidden="true">
    <div class="lantern-chain" />
    <div class="lantern-body lantern-body-small">
      <span class="lantern-glow" />
    </div>
  </div>

  <div class="hero-motes pointer-events-none absolute inset-0 z-[4]" aria-hidden="true">
    <span class="hero-mote left-[18%] top-[35%]" />
    <span class="hero-mote left-[78%] top-[32%]" />
    <span class="hero-mote left-[31%] top-[63%]" />
    <span class="hero-mote left-[68%] top-[68%]" />
  </div>

  <div class="relative z-10 mx-auto flex min-h-screen max-w-5xl flex-col items-center px-5 pb-12 pt-[12vh] text-center md:px-10 md:pt-[15vh]">
    <p class="hero-morph font-sans text-[9px] font-semibold uppercase tracking-[0.56em] text-[#f5d391]/90 md:text-[10px]">
      Marrakesh, Morocco
    </p>
    <h1
      class="hero-morph mt-5 text-[clamp(4.1rem,15vw,9rem)] leading-[0.78] text-[#fff6e4] drop-shadow-[0_8px_28px_rgba(0,0,0,0.55)]"
      style="font-family: 'Great Vibes', cursive;"
    >
      Tayo &amp; Ope
    </h1>
    <p
      class="hero-morph mt-7 max-w-xl text-balance font-serif text-[clamp(1.08rem,3vw,1.55rem)] italic leading-relaxed text-[#fff1d6]/90"
      style="font-family: 'Cormorant Garamond', Georgia, serif;"
    >
      Save the date for a celebration beneath lantern light and palms.
    </p>

    <div class="hero-morph hero-date-row mt-10 flex w-full max-w-2xl items-end justify-center gap-3 border-y border-[#f5d391]/25 bg-black/12 py-5 backdrop-blur-[2px] md:gap-7">
      <div class="text-center">
        <p class="font-sans text-[7px] uppercase tracking-[0.3em] text-[#f5d391]/70">From</p>
        <p class="mt-1 font-serif text-[clamp(1.45rem,4.5vw,2.15rem)] text-[#fff6e8]" style="font-family: 'Cormorant Garamond', serif;">15th</p>
      </div>
      <span class="mb-2 h-1 w-1 rounded-full bg-[#f5d391]/60" aria-hidden="true" />
      <div class="text-center">
        <p class="font-sans text-[7px] uppercase tracking-[0.3em] text-[#f5d391]/70">To</p>
        <p class="mt-1 font-serif text-[clamp(1.45rem,4.5vw,2.15rem)] text-[#fff6e8]" style="font-family: 'Cormorant Garamond', serif;">20th</p>
      </div>
      <span class="mb-2 h-1 w-1 rounded-full bg-[#f5d391]/60" aria-hidden="true" />
      <div class="text-center">
        <p class="font-sans text-[7px] uppercase tracking-[0.3em] text-[#f5d391]/70">Month</p>
        <p class="mt-1 font-serif text-[clamp(1.45rem,4.5vw,2.15rem)] text-[#fff6e8]" style="font-family: 'Cormorant Garamond', serif;">December</p>
      </div>
      <span class="mb-2 h-1 w-1 rounded-full bg-[#f5d391]/60" aria-hidden="true" />
      <div class="text-center">
        <p class="font-sans text-[7px] uppercase tracking-[0.3em] text-[#f5d391]/70">Year</p>
        <p class="mt-1 font-serif text-[clamp(1.45rem,4.5vw,2.15rem)] text-[#fff6e8]" style="font-family: 'Cormorant Garamond', serif;">2026</p>
      </div>
    </div>

    <div class="hero-reveal-block mt-auto flex w-full max-w-sm flex-col items-center pt-16 text-center md:pt-20">
      <p class="hero-morph font-sans text-[8px] font-semibold uppercase tracking-[0.5em] text-[#f5d391]/80">Save the date</p>
      <h2
        class="hero-morph mt-2 text-[clamp(2.2rem,7vw,3.6rem)] leading-tight text-[#fff6e8] drop-shadow-[0_4px_18px_rgba(0,0,0,0.45)]"
        style="font-family: 'Great Vibes', cursive; line-height: 1.05;"
      >
        Reveal our big day
      </h2>
      <p class="hero-morph mt-2 font-serif text-xs italic text-[#fff1d6]/80">Scratch the hearts to reveal</p>
      <div class="hero-morph hero-scratch-wrap relative mt-8 w-full max-w-sm">
        <ScratchHearts client:load />
      </div>
    </div>
  </div>

  <div class="hero-morph hero-bottom-scroll pointer-events-none absolute bottom-7 left-1/2 z-[12] flex -translate-x-1/2 flex-col items-center gap-1 text-[#fff1d6]/80 opacity-0">
    <span class="text-[7px] uppercase tracking-[0.32em]">Scroll to explore</span>
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
    </svg>
  </div>
</section>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  .hero-water {
    background:
      linear-gradient(180deg, rgba(20, 9, 5, 0) 0%, rgba(11, 6, 5, 0.52) 62%, rgba(7, 4, 3, 0.82) 100%),
      linear-gradient(92deg, rgba(255, 179, 84, 0.18), rgba(255, 231, 174, 0.04), rgba(255, 179, 84, 0.15));
    filter: blur(0.2px);
    transform-origin: 50% 100%;
    animation: waterShimmer 7s ease-in-out infinite;
  }

  .hero-water::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(100deg, transparent 0 42%, rgba(255, 190, 100, 0.12) 48%, transparent 56% 100%);
    background-size: 220% 100%;
    animation: reflectionSweep 8s ease-in-out infinite;
  }

  .lantern-chain {
    margin: 0 auto;
    height: 74px;
    width: 1px;
    background: linear-gradient(180deg, rgba(255, 218, 150, 0), rgba(255, 218, 150, 0.55));
  }

  .lantern-body {
    position: relative;
    width: 54px;
    height: 84px;
    border-radius: 26px 26px 18px 18px;
    border: 1px solid rgba(255, 219, 150, 0.44);
    background:
      radial-gradient(circle at 50% 50%, rgba(255, 181, 72, 0.95) 0%, rgba(255, 170, 56, 0.42) 35%, rgba(38, 18, 10, 0.78) 72%),
      linear-gradient(90deg, rgba(255,255,255,0.08), transparent 38%, rgba(0,0,0,0.25));
    box-shadow: 0 0 46px rgba(255, 156, 54, 0.35), inset 0 0 18px rgba(255, 231, 170, 0.22);
    animation: lanternFloat 4.8s ease-in-out infinite;
  }

  .lantern-body-small {
    width: 46px;
    height: 72px;
    animation-delay: -1.3s;
  }

  .lantern-glow {
    position: absolute;
    inset: 18% 26%;
    border-radius: 999px;
    background: rgba(255, 221, 141, 0.9);
    filter: blur(9px);
    animation: lanternPulse 2.8s ease-in-out infinite;
  }

  .hero-mote {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: rgba(255, 210, 133, 0.72);
    box-shadow: 0 0 18px rgba(255, 180, 84, 0.78);
    animation: moteDrift 7s ease-in-out infinite;
  }

  .hero-mote:nth-child(2) { animation-delay: -1.6s; }
  .hero-mote:nth-child(3) { animation-delay: -3.1s; }
  .hero-mote:nth-child(4) { animation-delay: -4.4s; }

  @keyframes waterShimmer {
    0%, 100% { opacity: 0.52; transform: scaleY(1); }
    50% { opacity: 0.72; transform: scaleY(1.03); }
  }

  @keyframes reflectionSweep {
    0%, 100% { background-position: 120% 0; }
    50% { background-position: -40% 0; }
  }

  @keyframes lanternFloat {
    0%, 100% { transform: translateY(0) rotate(-1.2deg); }
    50% { transform: translateY(9px) rotate(1.2deg); }
  }

  @keyframes lanternPulse {
    0%, 100% { opacity: 0.68; transform: scale(0.92); }
    50% { opacity: 1; transform: scale(1.08); }
  }

  @keyframes moteDrift {
    0%, 100% { opacity: 0.1; transform: translate3d(0, 18px, 0) scale(0.8); }
    45% { opacity: 0.8; }
    70% { opacity: 0.35; transform: translate3d(14px, -28px, 0) scale(1.15); }
  }

  @media (max-width: 767px) {
    .hero-bg {
      background-position: center top;
    }
  }
</style>
