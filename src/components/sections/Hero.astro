<section
  id="hero"
  class="hero-section relative flex min-h-[100svh] items-start justify-center overflow-hidden bg-[#e8e2cd] pt-[42vh] text-[#626951]"
>
  <video
    class="hero-video absolute inset-0 z-[1] h-full w-full object-cover object-center"
    src="/reference/majestic-hero-bg.mp4"
    poster="/reference/majestic-hero-poster.jpg"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"></video>

  <div
    class="relative z-10 flex flex-col items-center px-6 pt-[68px] text-center"
  >
    <p
      class="hero-morph mb-3 font-sans text-[11px] font-semibold uppercase tracking-[0.34em] text-[#626951]/75 md:text-sm"
    >
      We are getting married
    </p>

    <h1
      class="hero-morph text-[4.75rem] font-normal leading-[0.86] text-[#596347] drop-shadow-[0_2px_12px_rgba(255,250,232,0.42)] md:text-8xl"
      style="font-family: var(--font-family-script), 'Great Vibes', cursive;"
    >
      Tayo &amp; Ope
    </h1>

    <div class="hero-morph mt-5 flex items-center gap-4 text-[#626951]/75">
      <span class="h-px w-10 bg-current/35 md:w-14"></span>
      <p class="font-serif text-sm uppercase tracking-[0.24em] md:text-base">
        Marrakech, Morocco
      </p>
      <span class="h-px w-10 bg-current/35 md:w-14"></span>
    </div>
  </div>

  {/* Scroll cue — tap to scroll down */}
  <button
    type="button"
    data-scroll-cue
    aria-label="Scroll down"
    class="hero-morph group absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-2"
  >
    <span
      class="flex h-9 w-5 items-start justify-center rounded-full border border-[#626951]/40 p-1 transition group-hover:border-[#626951]/70"
    >
      <span class="hero-scroll-dot h-1.5 w-1.5 rounded-full bg-[#626951]/70"></span>
    </span>
    <span
      class="font-sans text-[9px] font-semibold uppercase tracking-[0.34em] text-[#626951]/65 transition group-hover:text-[#626951]"
    >
      Scroll
    </span>
  </button>
</section>

<style>
  .hero-video {
    filter: saturate(0.94) contrast(0.98) brightness(1.04)
      drop-shadow(0 0 34px rgba(42, 39, 28, 0.18));
  }

  .hero-morph {
    opacity: 0;
    transform: translateY(32px);
    filter: blur(8px);
  }

  .hero-scroll-dot {
    animation: heroScrollDot 1.8s ease-in-out infinite;
  }
  @keyframes heroScrollDot {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-morph {
      opacity: 1;
      transform: none;
      filter: none;
    }
    .hero-scroll-dot {
      animation: none;
    }

    .hero-video {
      display: none;
    }
    .hero-section {
      background:
        radial-gradient(
          circle at 50% 42%,
          rgba(255, 250, 232, 0.92),
          transparent 42%
        ),
        #e8e2cd;
    }
  }
</style>

<script>
  // Home page uses native scroll (no Lenis) — wire the cue to nudge down a
  // viewport so guests can see the page scrolls.
  document
    .querySelector<HTMLElement>("#hero [data-scroll-cue]")
    ?.addEventListener("click", () => {
      const lenis = (window as unknown as { __lenis?: { scrollTo: (y: number, o?: object) => void } }).__lenis;
      const y = window.scrollY + window.innerHeight * 0.9;
      if (lenis) lenis.scrollTo(y, { duration: 1.1 });
      else window.scrollTo({ top: y, behavior: "smooth" });
    });
</script>
