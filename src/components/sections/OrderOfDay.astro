---

---

<section
  id="order"
  class="relative overflow-hidden bg-white py-32"
  data-animate="order"
  data-section-title="Celebration Week"
>
  <div class="mx-auto max-w-3xl px-6">
    <div class="text-center">
      <p
        class="section-reveal font-sans text-[10px] uppercase tracking-[0.4em] text-[var(--color-gold)] opacity-0"
      >
        Celebration Flow
      </p>
      <h2
        class="section-reveal mt-3 font-serif text-4xl font-semibold text-[var(--color-charcoal)] opacity-0 md:text-5xl"
      >
        What the week will feel like
      </h2>
    </div>
    <div class="relative mt-20">
      <div
        class="timeline-line absolute left-6 top-0 h-full w-px origin-top scale-y-0 bg-gradient-to-b from-[var(--color-gold)] via-[var(--color-gold-light)] to-transparent md:left-1/2 md:-translate-x-px"
      >
      </div>
      {
        [
          {
            time: "16 Dec",
            title: "Arrival & Welcome Party",
            desc: "Guests arrive, settle in, and begin the celebration with music, drinks, and golden-hour energy.",
            emoji: "01",
            side: "left" as const,
          },
          {
            time: "17 Dec",
            title: "Traditional Wedding",
            desc: "A vibrant cultural celebration filled with family, colour, music, and unforgettable moments.",
            emoji: "02",
            side: "right" as const,
          },
          {
            time: "18 Dec",
            title: "Wedding Eve",
            desc: "A slower day to relax, explore Marrakesh, and prepare for the celebrations ahead.",
            emoji: "03",
            side: "left" as const,
          },
          {
            time: "19 Dec",
            title: "White Wedding & Reception",
            desc: "The ceremony, reception, dinner, dancing, and a beautiful night for Tayo and Ope.",
            emoji: "04",
            side: "right" as const,
          },
          {
            time: "20 Dec",
            title: "Farewell Brunch",
            desc: "One final gathering to share memories and send everyone home with love.",
            emoji: "05",
            side: "left" as const,
          },
        ].map((row) => (
          <div
            class={`timeline-item relative mb-12 flex items-start gap-6 opacity-0 last:mb-0 md:gap-0 ${row.side === "right" ? "md:flex-row-reverse" : "md:flex-row"}`}
          >
            <div
              class={
                row.side === "left"
                  ? "flex-1 md:w-1/2 md:pr-16 md:text-right"
                  : "flex-1 md:w-1/2 md:pl-16 md:text-left"
              }
            >
              <span class="font-sans text-xs font-semibold tracking-widest text-[var(--color-gold)]">
                {row.time}
              </span>
              <h3 class="mt-1 font-serif text-xl font-semibold text-[var(--color-charcoal)]">
                {row.title}
              </h3>
              <p class="mt-1 font-sans text-sm leading-relaxed text-gray-500">
                {row.desc}
              </p>
            </div>
            <div class="timeline-dot absolute left-6 flex h-12 w-12 -translate-x-1/2 items-center justify-center rounded-full border-2 border-[var(--color-gold-light)] bg-white text-xl shadow-sm md:left-1/2">
              {row.emoji}
            </div>
            <div class="hidden flex-1 md:block md:w-1/2" />
          </div>
        ))
      }
    </div>
  </div>
</section>
