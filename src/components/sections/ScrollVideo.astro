---
/**
 * GTA-VI-style scroll-scrubbed video.
 * The video pins to the viewport and its playhead is driven by scroll
 * (frame-by-frame). Optional hero text (eyebrow + title) shows at the start
 * and fades as you scroll in; an optional end `label` rises near the finish.
 * Reusable — works as a page hero or a mid/end interlude.
 */
interface Props {
  src: string;
  poster?: string;
  eyebrow?: string;
  title?: string;
  label?: string;
  heightVh?: number;
}
const { src, poster, eyebrow, title, label, heightVh = 300 } = Astro.props;
---

<section
  class="scroll-video relative w-full bg-black"
  style={`height:${heightVh}vh`}
>
  <div class="sv-pin sticky top-0 h-[100svh] w-full overflow-hidden bg-black">
    <video
      class="sv-video absolute inset-0 h-full w-full object-cover"
      src={src}
      poster={poster}
      muted
      playsinline
      preload="auto"
      aria-hidden="true"></video>
    {/* Legibility scrim — kept light so the footage stays bright on mobile,
        just enough at top/bottom for the title, cue and label. */}
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/30"
      aria-hidden="true"
    >
    </div>

    {/* Hero text — visible at the top, fades as the video scrubs in */}
    {
      title && (
        <div class="sv-hero pointer-events-none absolute inset-0 flex flex-col items-center justify-center px-6 text-center text-white">
          {eyebrow && (
            <p class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/[0.06] px-5 py-1.5 font-sans text-[10px] font-semibold uppercase tracking-[0.42em] text-white/85 backdrop-blur-md">
              <span class="h-1 w-1 rounded-full bg-[#e6c787]" />
              {eyebrow}
              <span class="h-1 w-1 rounded-full bg-[#e6c787]" />
            </p>
          )}
          <h1
            class="mt-7 text-[clamp(3rem,9vw,6rem)] font-normal leading-[0.9] drop-shadow-[0_4px_30px_rgba(0,0,0,0.6)]"
            style="font-family: var(--font-family-script), 'Great Vibes', cursive;"
          >
            {title}
          </h1>
        </div>
      )
    }

    {/* End label — rises over the final stretch */}
    {
      label && (
        <p
          class="sv-label pointer-events-none absolute inset-x-0 bottom-[14%] px-6 text-center font-[family-name:var(--font-family-script)] text-5xl text-[#e6c787] drop-shadow-[0_4px_24px_rgba(0,0,0,0.7)] md:text-7xl"
          style="opacity:0"
        >
          {label}
        </p>
      )
    }

    {/* Scroll cue */}
    <div
      class="sv-cue pointer-events-none absolute bottom-7 left-1/2 -translate-x-1/2"
      aria-hidden="true"
    >
      <span
        class="flex h-9 w-5 items-start justify-center rounded-full border border-white/35 p-1"
      >
        <span class="sv-dot h-1.5 w-1.5 rounded-full bg-white/75"></span>
      </span>
    </div>
  </div>
</section>

<style>
  /* Lift the footage a touch — it reads dark on small screens otherwise. */
  .sv-video {
    filter: brightness(1.12) saturate(1.05);
  }
  .sv-dot {
    animation: svScroll 1.8s ease-in-out infinite;
  }
  @keyframes svScroll {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sv-dot {
      animation: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>(".scroll-video").forEach((section) => {
    const video = section.querySelector<HTMLVideoElement>(".sv-video");
    const hero = section.querySelector<HTMLElement>(".sv-hero");
    const label = section.querySelector<HTMLElement>(".sv-label");
    const cue = section.querySelector<HTMLElement>(".sv-cue");
    if (!video) return;

    if (reduce) {
      video.setAttribute("autoplay", "");
      video.loop = true;
      video.play?.().catch(() => {});
      if (label) gsap.set(label, { autoAlpha: 1 });
      return;
    }

    video.pause();

    let dur = 0;
    let target = 0;
    const setDur = () => {
      dur = video.duration || 0;
      ScrollTrigger.refresh();
    };
    if (video.readyState >= 1 && video.duration) setDur();
    else video.addEventListener("loadedmetadata", setDur, { once: true });

    // Scroll drives the TARGET playhead; a ticker eases the real playhead
    // toward it so fast scrolls glide instead of snapping/stuttering.
    ScrollTrigger.create({
      trigger: section,
      start: "top top",
      end: "bottom bottom",
      scrub: true,
      onUpdate: (self) => {
        if (dur) target = Math.min(dur - 0.05, Math.max(0, self.progress * dur));
      },
    });

    // Only issue the next seek once the previous one resolves (avoids the
    // browser queueing seeks and glitching on rapid scroll).
    let seeking = false;
    video.addEventListener("seeking", () => (seeking = true));
    video.addEventListener("seeked", () => (seeking = false));
    gsap.ticker.add(() => {
      if (!dur || seeking) return;
      const cur = video.currentTime;
      const diff = target - cur;
      if (Math.abs(diff) > 0.01) {
        video.currentTime = cur + diff * 0.22;
      }
    });

    // Hero text + scroll cue fade out as the video takes over.
    if (hero || cue) {
      gsap.to([hero, cue].filter(Boolean), {
        autoAlpha: 0,
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "22% bottom",
          scrub: true,
        },
      });
    }

    // End label rises over the final stretch.
    if (label) {
      gsap.fromTo(
        label,
        { autoAlpha: 0, y: 30 },
        {
          autoAlpha: 1,
          y: 0,
          ease: "none",
          scrollTrigger: {
            trigger: section,
            start: "72% bottom",
            end: "94% bottom",
            scrub: true,
          },
        },
      );
    }
  });

  window.addEventListener("load", () => ScrollTrigger.refresh());
</script>
