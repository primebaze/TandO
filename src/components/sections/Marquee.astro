---
/**
 * Scrolling repeating-text divider band (Wix-template style).
 * Bold high-contrast display serif, uppercase, with a line-art bow ornament
 * between phrases. Scrolls continuously to the LEFT, seamless loop.
 */
interface Props {
  text: string;
  dark?: boolean;
}
const { text, dark = false } = Astro.props;
const items = Array.from({ length: 6 });

const textColor = dark ? "#e6c787" : "#6b2f28";
---

<div class="marquee relative flex overflow-hidden py-6">
  {
    [0, 1].map((dup) => (
      <div class="marquee-track flex shrink-0 items-center whitespace-nowrap" aria-hidden={dup === 1}>
        {items.map(() => (
          <>
            <span
              class="px-10 text-3xl font-[800] uppercase tracking-[0.08em] md:text-[2.6rem]"
              style={`font-family:'Playfair Display', var(--font-serif), serif; color:${textColor};`}
            >
              {text}
            </span>
            {/* line-art bow */}
            <svg
              class="h-7 w-11 shrink-0 md:h-8 md:w-12"
              viewBox="0 0 48 32"
              fill="none"
              stroke={textColor}
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M24 16C16 8 4 8 6 16C4 24 16 24 24 16Z" />
              <path d="M24 16C32 8 44 8 42 16C44 24 32 24 24 16Z" />
              <circle cx="24" cy="16" r="2.4" />
              <path d="M22.2 18C20.5 23 19.5 27 18.5 30.5" />
              <path d="M25.8 18C27.5 23 28.5 27 29.5 30.5" />
            </svg>
          </>
        ))}
      </div>
    ))
  }
</div>

<style>
  .marquee-track {
    animation: marqueeScroll 42s linear infinite;
  }
  /* Scrolls to the RIGHT — content enters from the left, exits right. */
  @keyframes marqueeScroll {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
