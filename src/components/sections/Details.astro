---

---

<section
  id="details"
  class="relative overflow-hidden bg-[#fffaf0] py-32"
  data-animate="details"
  data-section-title="Location"
>
  <div class="mx-auto max-w-4xl px-6">
    <div class="text-center">
      <p
        class="section-reveal font-sans text-[10px] uppercase tracking-[0.4em] text-[var(--color-gold)] opacity-0"
      >
        Key Bits of Information
      </p>
      <h2
        class="section-reveal mt-3 font-serif text-4xl font-semibold text-[var(--color-charcoal)] opacity-0 md:text-5xl"
      >
        Key details for Marrakesh
      </h2>
    </div>
    <div
      class="detail-card mt-16 overflow-hidden rounded-[2rem] border border-[var(--color-gold)]/12 bg-white/72 shadow-[0_28px_90px_rgba(90,50,26,0.10)] opacity-0 backdrop-blur"
    >
      <div class="relative h-64 overflow-hidden md:h-80">
        <img
          src="/images/hero.jpeg"
          alt="Marrakesh venue"
          class="h-full w-full object-cover"
          loading="lazy"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
        >
        </div>
        <div class="absolute bottom-0 left-0 p-8 text-white md:p-10">
          <p
            class="font-sans text-xs uppercase tracking-widest text-[var(--color-gold-light)]"
          >
            Destination
          </p>
          <h3 class="mt-1 font-serif text-3xl font-semibold md:text-4xl">
            Marrakesh, Morocco
          </h3>
          <p class="mt-1 font-sans text-sm text-white/75">
            A five-day celebration of candlelight, culture, and Marrakesh
            nights.
          </p>
        </div>
      </div>
      <div
        class="grid divide-y divide-gray-100 md:grid-cols-3 md:divide-x md:divide-y-0"
      >
        <div class="detail-item p-8 text-center opacity-0">
          <span class="font-serif text-3xl text-[var(--color-gold)]">01</span>
          <h4
            class="mt-3 font-serif text-lg font-semibold text-[var(--color-charcoal)]"
          >
            Wedding Of
          </h4>
          <p
            class="mt-1 text-3xl text-[var(--color-gold)]"
            style="font-family: var(--font-family-script), cursive;"
          >
            Tayo &amp; Ope
          </p>
          <p class="mt-2 font-sans text-xs text-gray-400">
            Together with our families
          </p>
        </div>
        <div class="detail-item p-8 text-center opacity-0">
          <span class="font-serif text-3xl text-[var(--color-gold)]">02</span>
          <h4
            class="mt-3 font-serif text-lg font-semibold text-[var(--color-charcoal)]"
          >
            Date
          </h4>
          <p
            class="mt-1 font-serif text-2xl font-light text-[var(--color-gold)]"
          >
            16th - 20th
          </p>
          <p class="mt-2 font-sans text-xs text-gray-400">December 2026</p>
        </div>
        <div class="detail-item p-8 text-center opacity-0">
          <span class="font-serif text-3xl text-[var(--color-gold)]">03</span>
          <h4
            class="mt-3 font-serif text-lg font-semibold text-[var(--color-charcoal)]"
          >
            Map
          </h4>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Marrakesh+Morocco"
            target="_blank"
            rel="noreferrer"
            class="mt-2 inline-flex border-b border-[var(--color-gold)] font-serif text-2xl text-[var(--color-gold)] transition-colors hover:text-[var(--color-gold-light)]"
          >
            Explore
          </a>
          <p class="mt-2 font-sans text-xs text-gray-400">
            Open Marrakesh on maps
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
