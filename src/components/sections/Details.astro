---
const celebrationDays = [
  { date: "16 Dec", title: "Arrival & Welcome Party" },
  { date: "17 Dec", title: "Traditional Wedding" },
  { date: "18 Dec", title: "Wedding Eve" },
  { date: "19 Dec", title: "White Wedding & Reception" },
  { date: "20 Dec", title: "Farewell Brunch" },
];
---

<section
  id="details"
  class="relative overflow-hidden bg-[#fffaf0] py-28"
  data-animate="details"
  data-section-title="Location"
>
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center">
      <p
        class="section-reveal font-sans text-[10px] font-semibold uppercase tracking-[0.4em] text-[var(--color-gold)] opacity-0"
      >
        Celebration Days
      </p>
      <h2
        class="section-reveal mt-3 font-serif text-4xl font-semibold text-[var(--color-charcoal)] opacity-0 md:text-6xl"
      >
        Days & Events
      </h2>
    </div>
    <div
      class="detail-card mt-14 overflow-hidden rounded-[2rem] border border-[var(--color-gold)]/12 bg-white/72 shadow-[0_28px_90px_rgba(90,50,26,0.10)] opacity-0 backdrop-blur"
    >
      <div class="relative h-64 overflow-hidden md:h-80">
        <img
          src="/images/hero.jpeg"
          alt="Marrakesh venue"
          class="h-full w-full object-cover"
          loading="lazy"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/45 to-transparent"
        >
        </div>
      </div>
      <div
        class="grid divide-y divide-gray-100 px-8 py-10 sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-5 lg:px-10 lg:py-12"
      >
        {
          celebrationDays.map((day, index) => (
            <div class="detail-item px-4 py-8 text-center opacity-0 sm:px-6 lg:min-h-52 lg:py-5">
              <span class="font-serif text-3xl text-[var(--color-gold)]">
                {String(index + 1).padStart(2, "0")}
              </span>
              <p class="mt-5 font-sans text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--color-gold)]">
                {day.date}
              </p>
              <h4 class="mt-3 font-serif text-xl font-semibold leading-tight text-[var(--color-charcoal)]">
                {day.title}
              </h4>
            </div>
          ))
        }
      </div>
      <div
        class="detail-item border-t border-gray-100 p-8 text-center opacity-0 md:p-12"
      >
        <p
          class="font-sans text-[10px] font-semibold uppercase tracking-[0.34em] text-[var(--color-gold)]"
        >
          Location
        </p>
        <h3
          class="mt-3 font-serif text-3xl font-semibold text-[var(--color-charcoal)] md:text-4xl"
        >
          Marrakesh, Morocco
        </h3>
        <a
          href="https://www.google.com/maps/search/?api=1&query=Marrakesh+Morocco"
          target="_blank"
          rel="noreferrer"
          class="mt-4 inline-flex border-b border-[var(--color-gold)] font-serif text-2xl text-[var(--color-gold)] transition-colors hover:text-[var(--color-gold-light)]"
        >
          Explore
        </a>
      </div>
    </div>
  </div>
</section>
