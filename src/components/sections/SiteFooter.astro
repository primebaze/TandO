---
/** Global site footer (Wix-template style), maroon palette. */
const year = 2026;

const links = [
  { label: "Home", href: "/" },
  { label: "RSVP", href: "/rsvp" },
  { label: "Travel", href: "/travel" },
  { label: "Explore", href: "/explore" },
  { label: "Schedule", href: "/schedule" },
  { label: "The Taros", href: "/the-taros" },
  { label: "Registry", href: "/registry" },
  { label: "Q&A", href: "/qa" },
];
---

<footer class="relative overflow-hidden bg-[#5a2a2e] px-6 pb-10 pt-20 text-[#fffdf0]">
  <div class="mx-auto max-w-5xl text-center">
    <p class="font-serif text-2xl italic md:text-3xl">We Can't Wait to Celebrate</p>
    <p
      class="mt-5 text-6xl font-bold tracking-tight md:text-7xl"
      style="font-family:'Playfair Display', serif;"
    >
      T&amp;O
    </p>

    <div class="mt-14 grid items-center gap-10 md:grid-cols-3">
      <!-- Event Details -->
      <div class="md:text-right">
        <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.3em] text-[#fffdf0]/70">
          Event Details
        </p>
        <p class="mt-4 font-serif text-lg leading-relaxed text-[#fffdf0]/90">
          16 – 20 December 2026<br />
          Marrakech, Morocco
        </p>
      </div>

      <!-- Centre flourish — simple elegant divider -->
      <div class="flex justify-center" aria-hidden="true">
        <svg
          class="h-6 w-48 text-[#e6c787]/70"
          viewBox="0 0 220 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.1"
          stroke-linecap="round"
        >
          <line x1="22" y1="12" x2="96" y2="12" />
          <line x1="124" y1="12" x2="198" y2="12" />
          <path d="M110 3 l6 9 -6 9 -6 -9 z" fill="currentColor" stroke="none" />
          <circle cx="22" cy="12" r="1.8" fill="currentColor" stroke="none" />
          <circle cx="198" cy="12" r="1.8" fill="currentColor" stroke="none" />
        </svg>
      </div>

      <!-- Ceremony & Reception -->
      <div class="md:text-left">
        <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.3em] text-[#fffdf0]/70">
          Ceremony &amp; Reception
        </p>
        <p class="mt-4 font-serif text-lg leading-relaxed text-[#fffdf0]/90">
          Traditional Welcome Party · 17 December 2026<br />
          White Wedding · 19 December 2026<br />
          Reception to follow
        </p>
      </div>
    </div>

    <a
      href="/rsvp"
      class="mt-14 inline-flex rounded-full bg-[#fffdf0] px-8 py-2.5 font-sans text-[11px] font-semibold uppercase tracking-[0.28em] text-[#5a2a2e] transition hover:bg-white"
    >
      RSVP
    </a>

    <!-- Explore the pages -->
    <nav
      aria-label="Site pages"
      class="mx-auto mt-16 flex max-w-3xl flex-wrap items-center justify-center gap-x-4 gap-y-4 border-t border-[#fffdf0]/12 pt-12"
    >
      {
        links.map((link, i) => (
          <>
            {i > 0 && (
              <svg
                class="h-2 w-2 text-[#e6c787]/50"
                viewBox="0 0 10 10"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M5 0 6 4 10 5 6 6 5 10 4 6 0 5 4 4 z" />
              </svg>
            )}
            <a
              href={link.href}
              class="footer-link relative font-serif text-[13px] uppercase tracking-[0.26em] text-[#fffdf0]/80 transition-colors duration-300 hover:text-[#e6c787]"
            >
              {link.label}
              <span class="footer-underline" />
            </a>
          </>
        ))
      }
    </nav>
  </div>

  <!-- Bottom bar -->
  <div
    class="mx-auto mt-16 flex max-w-6xl flex-col gap-3 border-t border-[#fffdf0]/15 pt-6 text-center md:flex-row md:items-center md:justify-between md:text-left"
  >
    <p class="font-[family-name:var(--font-family-script)] text-2xl text-[#fffdf0]">
      #ToTheTaros
    </p>
    <p class="font-sans text-sm text-[#fffdf0]/70">
      © {year} Tayo &amp; Ope · Crafted and Designed by{" "}
      <a
        href="https://bazeflix.co.uk"
        target="_blank"
        rel="noreferrer"
        class="text-[#fffdf0] underline-offset-2 hover:underline"
      >
        Bazeflix
      </a>
    </p>
  </div>
</footer>

<style>
  .footer-underline {
    position: absolute;
    left: 0;
    bottom: -6px;
    height: 1px;
    width: 0;
    background: #e6c787;
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .footer-link:hover .footer-underline {
    width: 100%;
  }
</style>
