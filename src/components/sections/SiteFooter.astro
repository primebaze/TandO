---
/** Global site footer (Wix-template style), maroon palette. */
const year = 2026;
---

<footer class="relative overflow-hidden bg-[#5a2a2e] px-6 pb-10 pt-20 text-[#fffdf0]">
  <div class="mx-auto max-w-5xl text-center">
    <p class="font-serif text-2xl italic md:text-3xl">We Can't Wait to Celebrate</p>
    <p
      class="mt-5 text-6xl font-bold tracking-tight md:text-7xl"
      style="font-family:'Playfair Display', serif;"
    >
      T&amp;O
    </p>

    <div class="mt-14 grid items-center gap-10 md:grid-cols-3">
      <!-- Event Details -->
      <div class="md:text-right">
        <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.3em] text-[#fffdf0]/70">
          Event Details
        </p>
        <p class="mt-4 font-serif text-lg leading-relaxed text-[#fffdf0]/90">
          16 – 20 December 2026<br />
          Marrakech, Morocco
        </p>
      </div>

      <!-- Centre flourish -->
      <div class="flex justify-center" aria-hidden="true">
        <svg
          class="h-20 w-44 text-[#fffdf0]/80"
          viewBox="0 0 180 80"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
        >
          <path d="M10 46c22 0 28-18 50-18s28 18 50 18" opacity="0.5" />
          <path d="M170 46c-22 0-28-18-50-18" opacity="0.5" />
          <path d="M90 18c4 0 7 3 7 7s-3 9-7 13c-4-4-7-9-7-13s3-7 7-7Z" />
          <path d="M30 52l-6 14M44 54l-3 16M150 52l6 14M136 54l3 16" opacity="0.7" />
          <circle cx="22" cy="70" r="3" />
          <circle cx="40" cy="73" r="3" />
          <circle cx="158" cy="70" r="3" />
          <circle cx="140" cy="73" r="3" />
        </svg>
      </div>

      <!-- Ceremony & Reception -->
      <div class="md:text-left">
        <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.3em] text-[#fffdf0]/70">
          Ceremony &amp; Reception
        </p>
        <p class="mt-4 font-serif text-lg leading-relaxed text-[#fffdf0]/90">
          White Wedding · 19 December 2026<br />
          Le Méridien N'Fis, Marrakech<br />
          Reception to follow
        </p>
      </div>
    </div>

    <a
      href="/rsvp"
      class="mt-14 inline-flex rounded-full bg-[#fffdf0] px-8 py-2.5 font-sans text-[11px] font-semibold uppercase tracking-[0.28em] text-[#5a2a2e] transition hover:bg-white"
    >
      RSVP
    </a>
  </div>

  <!-- Bottom bar -->
  <div
    class="mx-auto mt-16 flex max-w-6xl flex-col gap-3 border-t border-[#fffdf0]/15 pt-6 text-center md:flex-row md:items-center md:justify-between md:text-left"
  >
    <p class="font-[family-name:var(--font-family-script)] text-2xl text-[#fffdf0]">
      #ToTheTaros
    </p>
    <p class="font-sans text-sm text-[#fffdf0]/70">
      © {year} Tayo &amp; Ope · Crafted and Designed by{" "}
      <a
        href="https://bazeflix.co.uk"
        target="_blank"
        rel="noreferrer"
        class="text-[#fffdf0] underline-offset-2 hover:underline"
      >
        Bazeflix
      </a>
    </p>
  </div>
</footer>
