---
import GatedLayout from "../layouts/GatedLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import Marquee from "../components/sections/Marquee.astro";

const bride = [
  { name: "Yves Saint Laurent Museum", kind: "Tourist attraction" },
  { name: "Majorelle Garden", kind: "Tourist attraction" },
  { name: "Restaurant Leopard Marrakesh", kind: "Restaurant" },
  { name: "Marajah Spa", kind: "Spa" },
  { name: "Café del Mar", kind: "Beach club" },
  { name: "Souk Market", kind: "Market" },
];

const groom = [
  { name: "Buddha Bar Marrakech", kind: "Restaurant" },
  { name: "Nobu Rooftop", kind: "Restaurant" },
  { name: "La Trattoria", kind: "Restaurant" },
  { name: "Safran by Koya", kind: "Restaurant" },
  { name: "Oberoi", kind: "Restaurant" },
];

const tips = [
  {
    icon: "sim",
    no: "01",
    title: "Hold off on the airport SIM",
    body: "Prices at the airport are usually much higher than elsewhere in the city.",
  },
  {
    icon: "cash",
    no: "02",
    title: "Bring cash, exchange locally",
    body: "You'll often find better exchange rates outside the airport.",
  },
  {
    icon: "plug",
    no: "03",
    title: "Pack a Type C (2-pin) adapter",
    body: "A small item that's easy to forget but very useful once you arrive.",
  },
  {
    icon: "weather",
    no: "04",
    title: "Warm days, cooler evenings",
    body: "December in Marrakech surprises you — sunshine by day, a chill at night.",
  },
];

const tipIcons: Record<string, string> = {
  sim: '<rect x="6" y="3" width="12" height="18" rx="2"/><line x1="9" y1="18" x2="15" y2="18"/>',
  cash: '<rect x="3" y="6" width="18" height="12" rx="1.5"/><circle cx="12" cy="12" r="2.5"/><line x1="6" y1="9" x2="6" y2="9.01"/><line x1="18" y1="15" x2="18" y2="15.01"/>',
  plug: '<path d="M9 2v6M15 2v6"/><path d="M6 8h12v3a6 6 0 0 1-12 0V8Z"/><path d="M12 17v5"/>',
  weather: '<circle cx="12" cy="11" r="4"/><path d="M12 2v2M12 18v2M4.2 11H2.2M21.8 11h-2M5 4l1.4 1.4M17.6 16.6 19 18M19 4l-1.4 1.4M6.4 16.6 5 18"/>',
};
---

<GatedLayout
  title="Explore Morocco — Tayo & Ope"
  description="The couple's favourite places in Marrakech, plus travel tips for your stay."
>
  <PageHero
    media="image"
    src="/images/hero.jpeg"
    eyebrow="The Red City"
    title="Explore Morocco"
    subtitle="A few of our favourite things to experience while you're here."
  />

  <main
    class="relative z-10 overflow-hidden bg-[#fffdf0] text-[#76353a] shadow-[0_-40px_80px_rgba(0,0,0,0.25)]"
  >
    <!-- Intro -->
    <section class="reveal mx-auto max-w-2xl px-6 pt-24 text-center md:pt-32">
      <p
        class="font-[family-name:var(--font-family-script)] text-4xl text-[#76353a] md:text-5xl"
      >
        Explore with the Taros
      </p>
      <p class="mx-auto mt-6 max-w-xl font-serif text-lg leading-relaxed text-[#76353a]/85">
        Between the celebrations, take time to wander. Here are the places we
        love most in Marrakech.
      </p>
    </section>

    <div class="reveal mt-16">
      <Marquee text="Explore Marrakech" />
    </div>

    <!-- Favourites -->
    <section class="mx-auto mt-16 max-w-5xl px-6">
      <div class="grid gap-12 md:grid-cols-2 md:gap-16">
        <div class="reveal">
          <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.34em] text-[#76353a]/70">
            The Bride's Favourites
          </p>
          <ul class="mt-6 divide-y divide-[#76353a]/12 border-y border-[#76353a]/12">
            {
              bride.map((p) => (
                <li class="flex items-baseline justify-between gap-4 py-4">
                  <span class="font-serif text-xl">{p.name}</span>
                  <span class="shrink-0 font-sans text-[10px] uppercase tracking-[0.2em] text-[#76353a]/55">
                    {p.kind}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="reveal">
          <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.34em] text-[#76353a]/70">
            The Groom's Favourites
          </p>
          <ul class="mt-6 divide-y divide-[#76353a]/12 border-y border-[#76353a]/12">
            {
              groom.map((p) => (
                <li class="flex items-baseline justify-between gap-4 py-4">
                  <span class="font-serif text-xl">{p.name}</span>
                  <span class="shrink-0 font-sans text-[10px] uppercase tracking-[0.2em] text-[#76353a]/55">
                    {p.kind}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Travel tips · colored band -->
    <section class="mt-28 bg-[#76353a] px-6 py-24 text-[#fffdf0]">
      <div class="mx-auto max-w-5xl">
        <div class="reveal text-center">
          <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.34em] text-[#fffdf0]/70">
            Travel Tips from the Taros
          </p>
          <h2 class="mt-4 font-serif text-3xl font-semibold md:text-4xl">
            A few things we wish someone told us.
          </h2>
        </div>
        <div class="mt-16 grid gap-x-12 gap-y-12 sm:grid-cols-2">
          {
            tips.map((tip) => (
              <div class="reveal flex gap-5">
                <div class="flex-shrink-0">
                  <div class="flex h-14 w-14 items-center justify-center rounded-full border border-[#e6c787]/35 text-[#e6c787]">
                    <svg
                      class="h-6 w-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={tipIcons[tip.icon]}
                    />
                  </div>
                </div>
                <div>
                  <p class="font-[family-name:var(--font-family-script)] text-2xl leading-none text-[#e6c787]/70">
                    {tip.no}
                  </p>
                  <h3 class="mt-2 font-serif text-2xl font-semibold">{tip.title}</h3>
                  <p class="mt-2 font-serif text-base leading-relaxed text-[#fffdf0]/80">
                    {tip.body}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="reveal mx-auto max-w-2xl px-6 py-24 text-center md:py-28">
      <p class="font-serif text-xl italic leading-relaxed text-[#76353a]/85">
        Come ready to celebrate, relax, and enjoy everything Marrakech has to
        offer.
      </p>
      <p
        class="mt-6 font-[family-name:var(--font-family-script)] text-4xl text-[#76353a] md:text-5xl"
      >
        #ToTheTaros
      </p>
    </section>
  </main>
</GatedLayout>
