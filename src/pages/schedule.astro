---
import GatedLayout from "../layouts/GatedLayout.astro";
import ArchHero from "../components/sections/ArchHero.astro";

const days = [
  {
    date: "16th December 2026",
    title: "Welcome & Arrivals",
    body: "Welcome! Guests arrive, check in, and settle into the beautiful surroundings. In the evening, join us for an optional night out with a night of music, drinks, great energy, and our first golden-hour toast.",
  },
  {
    date: "17th December 2026",
    title: "Traditional Welcome Party",
    body: "One of the most special moments of our celebration. Join us for our Nigerian Traditional Wedding, filled with rich culture, vibrant attire, music, and unforgettable energy.",
  },
  {
    date: "18th December 2026",
    title: "Wedding Eve",
    body: "A slower-paced day to relax and recharge before the big day and enjoy the city. Choose from curated activities including city tours, soul walks, desert safari adventures, shopping, tea lounges, or simply relaxing with soft lantern lights to prepare for the celebration ahead.",
  },
  {
    date: "19th December 2026",
    title: "White Wedding & Reception",
    body: "Our special day. Celebrate with us as we say “I do”, followed by a beautiful reception and an unforgettable afterparty.",
  },
  {
    date: "20th December 2026",
    title: "Farewell Brunch",
    body: "As the celebrations come to an end, one last gathering to wish you a safe journey before you board your flights shortly after, and a heartfelt thank you for being part of such a meaningful time with us.",
  },
];

const dressCode = [
  {
    event: "Traditional Wedding · 17 December",
    style: "Laced in Love",
    accent: "Shades of Pink 🎀",
    accentColor: "#c85f88",
    body: [
      "A beautiful celebration of love dressed in elegance, unity, and grace.",
      "For our special day, we kindly ask that guests come dressed in any shade of pink lace attire.",
      "Aso Ebi is also available for friends and family who would like to wear the same fabric as the parents of the couple. If you're interested in purchasing the Aso Ebi, please reach out directly to either of the couple's parents for more information.",
      "Let's create a stunning sea of pink as we come together to celebrate love, family, and new beginnings.",
    ],
    img: "/pagesphotos/dresscode/WhatsApp Image 2026-07-03 at 00.02.42(1).jpeg",
    contain: true,
  },
  {
    event: "White Wedding · 19 December",
    style: "Monochrome Magic",
    accent: null,
    accentColor: null,
    body: [
      "For our white wedding, we kindly invite all guests to celebrate with us with a Monochrome Magic dress code.",
      "Monochrome is all about wearing one colour from head to toe. Choose your favourite colour and style your entire outfit in that single shade for a chic, elegant, and coordinated look.",
      "We can't wait to celebrate this unforgettable day with you! 💍🤍",
    ],
    img: "/pagesphotos/dresscode/WhatsApp Image 2026-06-17 at 09.25.14.jpeg",
    contain: true,
  },
];
---

<GatedLayout
  title="Schedule of Events — Tayo & Ope"
  description="The full schedule for our wedding weekend in Marrakech, 16–20 December 2026."
>
  <ArchHero
    src="/images/hero-schedule.jpg"
    eyebrow="16 – 20 December 2026"
    title="Our Wedding Weekend"
    subtitle="Five days of culture, celebration, and love in the heart of Marrakech."
  />

  <main class="relative z-10 overflow-hidden bg-[#fffaf0] pb-28 shadow-[0_-40px_80px_rgba(0,0,0,0.25)]">
    <!-- Timeline -->
    <section class="mx-auto max-w-4xl px-6 pt-24">
      <div class="relative">
        <!-- vertical line -->
        <span
          class="absolute left-[22px] top-2 hidden h-full w-px bg-gradient-to-b from-[var(--color-gold)]/50 via-[var(--color-gold)]/25 to-transparent md:block"
          aria-hidden="true"></span>

        <ol class="space-y-14">
          {
            days.map((day, i) => (
              <li class="reveal relative md:pl-20">
                {/* marker */}
                <span
                  class="absolute left-0 top-1 hidden h-11 w-11 items-center justify-center rounded-full border border-[var(--color-gold)]/40 bg-[#fffaf0] font-serif text-lg text-[var(--color-gold)] md:flex"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="rounded-[1.75rem] border border-[var(--color-gold)]/12 bg-white/70 p-7 shadow-[0_20px_60px_rgba(90,50,26,0.07)] backdrop-blur md:p-9">
                  <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.32em] text-[var(--color-gold)]">
                    {day.date}
                  </p>
                  <h2 class="mt-2 font-serif text-3xl font-semibold text-[var(--color-charcoal)] md:text-4xl">
                    {day.title}
                  </h2>
                  <p class="mt-4 max-w-2xl font-serif text-lg leading-relaxed text-[#5d574a]">
                    {day.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Dress code -->
    <section class="mx-auto mt-28 max-w-5xl px-6">
      <div class="reveal text-center">
        <p
          class="font-sans text-[10px] font-semibold uppercase tracking-[0.42em] text-[var(--color-gold)]"
        >
          What to Wear
        </p>
        <h2
          class="mt-3 font-serif text-4xl font-semibold text-[var(--color-charcoal)] md:text-6xl"
        >
          Dress Code
        </h2>
      </div>

      <div class="mt-16 space-y-20">
        {
          dressCode.map((dc) => (
            <div class="reveal">
              <div class="mx-auto max-w-2xl text-center">
                <p class="font-sans text-[10px] font-semibold uppercase tracking-[0.3em] text-[var(--color-gold)]">
                  {dc.event}
                </p>
                <h3 class="mt-4 font-[family-name:var(--font-family-script)] text-5xl text-[var(--color-charcoal)] md:text-6xl">
                  {dc.style}
                </h3>
                {dc.accent && (
                  <p
                    class="mt-2 font-serif text-2xl italic md:text-3xl"
                    style={`color:${dc.accentColor};`}
                  >
                    {dc.accent}
                  </p>
                )}
                <div class="mx-auto mt-5 h-px w-16 bg-[var(--color-gold)]/40" />
                {dc.body.map((para) => (
                  <p class="mx-auto mt-5 max-w-xl font-serif text-lg leading-relaxed text-[#5d574a]">
                    {para}
                  </p>
                ))}
              </div>
              <div class="mt-10 overflow-hidden rounded-[1.5rem] bg-white shadow-[0_24px_70px_rgba(90,50,26,0.1)] ring-1 ring-[var(--color-gold)]/10">
                <img
                  src={dc.img}
                  alt={`${dc.style} dress code inspiration`}
                  class="w-full object-contain"
                  loading="lazy"
                />
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</GatedLayout>
