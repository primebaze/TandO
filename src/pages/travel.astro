---
import GatedLayout from "../layouts/GatedLayout.astro";
import ArchHero from "../components/sections/ArchHero.astro";
import Marquee from "../components/sections/Marquee.astro";

const bookingUrl =
  "https://www.marriott.com/en-gb/event-reservations/reservation-link.mi?id=1782748635355&key=GRP&app=resvlink&_p=c91429c099007af1e11990fce8bc";
---

<GatedLayout
  title="Travel & Accommodation — Tayo & Ope"
  description="Travel information and accommodation recommendations for our wedding in Marrakech, Morocco."
>
  <ArchHero
    video="/hero.mp4"
    poster="/images/hero-travel.jpg"
    eyebrow="Marrakech · Morocco"
    title="Planning Your Journey"
    subtitle="Everything you need to travel to and stay in the Red City for our celebration."
  />

  <main
    class="relative z-10 overflow-hidden bg-[#fffaf0] shadow-[0_-40px_80px_rgba(0,0,0,0.25)]"
  >
    <!-- Intro -->
    <section class="reveal mx-auto max-w-3xl px-6 pt-24 text-center md:pt-32">
      <p
        class="font-[family-name:var(--font-family-script)] text-4xl text-[var(--color-gold)] md:text-5xl"
      >
        Bienvenue à Marrakech
      </p>
      <p
        class="mx-auto mt-6 max-w-xl font-serif text-2xl leading-relaxed text-[#5d574a] md:text-3xl"
      >
        A few notes to carry you smoothly to the Red City — and into the
        celebration.
      </p>
    </section>

    <!-- Marquee -->
    <div class="reveal mt-20">
      <Marquee text="Travel &amp; Stay" />
    </div>

    <!-- Travel Plans · colored band with paired icon cards -->
    <section class="relative overflow-hidden bg-[#2a1813] py-24">
      <div
        class="pointer-events-none absolute inset-0 opacity-60"
        style="background: radial-gradient(70% 60% at 50% 0%, rgba(160,120,30,0.18), transparent 60%);"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-w-5xl px-6">
        <div class="reveal text-center">
          <p
            class="font-sans text-[10px] font-semibold uppercase tracking-[0.4em] text-[#e6c787]/70"
          >
            Travel Plans for Our Guests
          </p>
          <h2
            class="mx-auto mt-4 max-w-2xl font-serif text-3xl font-semibold leading-snug text-[#f5f0de] md:text-4xl"
          >
            Here's how to reach us and get around once you land.
          </h2>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2">
          <!-- Arriving by Air -->
          <div
            class="reveal rounded-[1.75rem] border border-[#e6c787]/15 bg-[#fffaf0] p-9 text-center"
          >
            <svg
              class="mx-auto h-9 w-9 text-[var(--color-gold)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M17.8 19.2 16 11l3.5-3.5a2.1 2.1 0 0 0-3-3L13 8 4.8 6.2a.5.5 0 0 0-.5.8l3.9 3.9-2.3 2.3-1.9-.4a.5.5 0 0 0-.5.8l2 2 2 2a.5.5 0 0 0 .8-.5l-.4-1.9 2.3-2.3 3.9 3.9a.5.5 0 0 0 .8-.5Z"></path>
            </svg>
            <h3
              class="mt-5 font-serif text-3xl font-semibold uppercase tracking-wide text-[var(--color-charcoal)]"
            >
              Arriving by Air
            </h3>
            <div class="mx-auto mt-4 h-px w-12 bg-[var(--color-gold)]/40"></div>
            <p class="mt-5 font-serif text-lg leading-relaxed text-[#5d574a]">
              Fly into <strong>Marrakesh Menara Airport (RAK)</strong> — just a
              12-minute drive from the venue. We kindly ask guests to arrive on
              or before <strong>16 December 2026</strong>.
            </p>
          </div>

          <!-- Getting Around -->
          <div
            class="reveal rounded-[1.75rem] border border-[#e6c787]/15 bg-[#fffaf0] p-9 text-center"
          >
            <svg
              class="mx-auto h-9 w-9 text-[var(--color-gold)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 13l1.5-4.5A2 2 0 0 1 8.4 7h7.2a2 2 0 0 1 1.9 1.5L19 13"></path>
              <path d="M5 13h14v4a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-1H8v1a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-4Z"></path>
              <circle cx="7.5" cy="15.5" r=".6"></circle>
              <circle cx="16.5" cy="15.5" r=".6"></circle>
            </svg>
            <h3
              class="mt-5 font-serif text-3xl font-semibold uppercase tracking-wide text-[var(--color-charcoal)]"
            >
              Getting Around
            </h3>
            <div class="mx-auto mt-4 h-px w-12 bg-[var(--color-gold)]/40"></div>
            <p class="mt-5 font-serif text-lg leading-relaxed text-[#5d574a]">
              Download <strong>Bolt</strong> before you land for convenient
              rides. For airport transfers, you can also reach us on WhatsApp:
            </p>
            <ul class="mt-4 space-y-2 font-serif text-base text-[#5d574a]">
              <li>
                Bi-Adroit Tours:
                <a
                  href="https://wa.me/2348034706057"
                  target="_blank"
                  rel="noopener"
                  class="text-[var(--color-gold)] underline-offset-4 hover:underline"
                  >+234 803 470 6057</a
                >
              </li>
              <li>
                Local Taxi:
                <a
                  href="https://wa.me/212602349040"
                  target="_blank"
                  rel="noopener"
                  class="text-[var(--color-gold)] underline-offset-4 hover:underline"
                  >+212 602 349 040</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Full-width airport photo band -->
    <section class="reveal relative h-[44svh] min-h-[320px] overflow-hidden">
      <img
        src="/pagesphotos/airport/marrakech-airport-morocco.jpg"
        alt="Marrakesh Menara Airport"
        class="h-full w-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/15 to-transparent"></div>
      <p
        class="absolute bottom-8 left-1/2 -translate-x-1/2 text-center font-[family-name:var(--font-family-script)] text-4xl text-white drop-shadow-lg md:text-6xl"
      >
        Welcome to Marrakech
      </p>
    </section>

    <!-- Accommodation · overlapping card -->
    <section class="reveal mx-auto max-w-6xl px-6 py-24 md:py-32">
      <div class="relative md:pl-24">
        <div
          class="overflow-hidden rounded-[2rem] shadow-[0_30px_80px_rgba(90,50,26,0.18)]"
        >
          <img
            src="/pagesphotos/hotel/56b41503.avif"
            alt="Le Méridien N'Fis, Marrakech"
            class="h-[360px] w-full object-cover md:h-[520px]"
            loading="lazy"
          />
        </div>
        <!-- overlapping detail card -->
        <div
          class="relative -mt-16 ml-auto max-w-md rounded-[1.75rem] border border-[var(--color-gold)]/15 bg-[#fffaf0] p-8 shadow-[0_24px_70px_rgba(90,50,26,0.14)] md:absolute md:-left-0 md:bottom-12 md:mt-0 md:p-10"
        >
          <p
            class="font-sans text-[10px] font-semibold uppercase tracking-[0.4em] text-[var(--color-gold)]"
          >
            Where to Stay
          </p>
          <h2
            class="mt-3 font-serif text-3xl font-semibold leading-tight text-[var(--color-charcoal)] md:text-4xl"
          >
            Le Méridien N'Fis
          </h2>
          <p class="mt-4 font-serif text-lg leading-relaxed text-[#5d574a]">
            Most of our wedding celebrations will take place here, so we
            recommend staying at Le Méridien N'Fis to be close to all the
            festivities and the Marrakech city centre.
          </p>
          <p
            class="mt-4 flex items-center gap-2.5 font-serif text-base text-[var(--color-charcoal)]"
          >
            <svg
              class="h-5 w-5 shrink-0 text-[var(--color-gold)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 8h1a3 3 0 0 1 0 6h-1"></path>
              <path d="M4 8h14v6a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8Z"></path>
              <path d="M7 4.5c.4.4.4 1 0 1.5M11 4.5c.4.4.4 1 0 1.5M15 4.5c.4.4.4 1 0 1.5"></path>
            </svg>
            <span><strong>Breakfast is included</strong> with every room.</span>
          </p>
          <p class="mt-3 font-serif text-base text-[#5d574a]/80">
            Avenue Mohammed VI · Marrakech 40000, Morocco<br />
            <span class="text-[var(--color-gold)]">@lemeridiennfis.marrakech</span>
          </p>
          <div
            class="mt-6 rounded-2xl border border-[var(--color-gold)]/15 bg-[var(--color-gold)]/[0.06] px-5 py-4"
          >
            <p
              class="font-sans text-[10px] font-semibold uppercase tracking-[0.3em] text-[var(--color-gold)]"
            >
              Guest Discount
            </p>
            <p class="mt-1.5 font-serif text-base leading-relaxed text-[var(--color-charcoal)]">
              We've arranged a special discount for our guests. Use the link
              below when booking to access our guest rates.
            </p>
            <a
              href={bookingUrl}
              target="_blank"
              rel="noopener"
              class="mt-4 inline-flex min-h-11 items-center justify-center rounded-full bg-[var(--color-gold)] px-6 font-sans text-[11px] font-semibold uppercase tracking-[0.2em] text-white transition hover:brightness-110"
            >
              Book with our discount
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Visa + closing -->
    <section class="reveal mx-auto max-w-2xl px-6 pb-28 text-center">
      <div class="mx-auto h-px w-20 bg-[var(--color-gold)]/40"></div>
      <p
        class="mt-8 font-[family-name:var(--font-family-script)] text-4xl text-[var(--color-gold)] md:text-5xl"
      >
        Need a visa?
      </p>
      <p class="mx-auto mt-5 max-w-xl font-serif text-lg leading-relaxed text-[#5d574a]">
        We've partnered with <strong>Bi-Adroit Tours &amp; Travel</strong> to
        help with every visa application to Morocco.
      </p>
      <a
        href="tel:+2348034706057"
        class="mt-6 inline-block font-sans text-sm tracking-[0.1em] text-[var(--color-gold)] underline-offset-4 hover:underline"
        >+234 803 470 6057</a
      >
      <p class="mt-12 font-serif text-lg italic leading-relaxed text-[#5d574a]">
        December is a busy travel season — we gently encourage you to book
        early.
      </p>
    </section>
  </main>
</GatedLayout>
