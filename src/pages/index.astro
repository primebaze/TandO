---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnvelopeScreen from "../components/react/EnvelopeScreen";
import DateReveal from "../components/react/DateReveal";
import Hero from "../components/sections/Hero.astro";
import Countdown from "../components/sections/Countdown.astro";
import Details from "../components/sections/Details.astro";
import DressCode from "../components/sections/DressCode.astro";
---

<BaseLayout>
  <img
    src="/assets/cherub.png"
    alt=""
    aria-hidden="true"
    class="cherub-float pointer-events-none fixed bottom-28 left-4 z-40 w-20 mix-blend-multiply md:bottom-32 md:left-8 md:w-28"
  />
  <div id="main-content" class="opacity-0" aria-hidden="true">
    <Hero />
    <DateReveal client:load />
    <Countdown />
    <Details />
    <DressCode />
    <footer
      id="rsvp-panel"
      class="relative overflow-hidden bg-[#efe7d7] py-16 text-center text-[#3d3026]"
      data-section-title="RSVP"
    >
      <div class="footer-content relative z-10 mx-auto max-w-lg px-6 opacity-0">
        <!-- Ornament frame with content layered inside -->
        <div class="relative mx-auto w-full max-w-sm md:max-w-md">
          <img
            src="/assets/footer-ornament.png"
            alt=""
            aria-hidden="true"
            class="w-full"
          />
          <!-- Content centred inside the arch opening -->
          <div class="absolute inset-0 flex flex-col items-center justify-center px-10 pt-[28%] pb-[12%]">
            <p
              class="font-sans text-[9px] font-semibold uppercase tracking-[0.42em] text-[var(--color-gold)]"
            >
              RSVP
            </p>
            <h2 class="mt-2 font-serif text-xl font-semibold leading-snug text-[#2d271f] md:text-2xl">
              We hope you can make it
            </h2>
            <p class="mt-2 font-serif text-xs leading-relaxed text-[#5d574a] md:text-sm">
              Join us in Marrakesh for a week of celebration, culture, and love.
            </p>
            <a
              href="/rsvp"
              class="mt-5 inline-flex min-h-10 items-center justify-center rounded-full border border-[var(--color-gold)] bg-white/70 px-8 font-serif text-[11px] uppercase tracking-[0.22em] text-[#4b3926] shadow-[0_8px_24px_rgba(90,50,26,0.12)] transition duration-300 hover:-translate-y-0.5 hover:bg-white"
            >
              Send RSVP
            </a>
          </div>
        </div>

        <p
          class="mt-6 font-[family-name:var(--font-family-script)] text-5xl text-[var(--color-gold)] md:text-6xl"
        >
          Tayo + Ope
        </p>
        <p
          class="mt-3 font-sans text-[10px] uppercase tracking-[0.34em] text-[#5d574a]/60"
        >
          With love
        </p>
      </div>
    </footer>
  </div>
  <EnvelopeScreen client:load />
  <style>
    .cherub-float {
      animation: cherub-bob 4s ease-in-out infinite;
      transform-origin: center bottom;
    }
    @keyframes cherub-bob {
      0%, 100% { transform: translateY(0px) rotate(-4deg); }
      50%       { transform: translateY(-14px) rotate(2deg); }
    }
  </style>
  <script>
    import { playHeroIntro, initScrollAnimations } from "../scripts/animations";

    window.addEventListener(
      "envelope-opened",
      () => {
        playHeroIntro();
        requestAnimationFrame(() => {
          initScrollAnimations();
        });
      },
      { once: true },
    );
  </script>
</BaseLayout>
