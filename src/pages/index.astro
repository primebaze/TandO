---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnvelopeScreen from "../components/react/EnvelopeScreen";
import DateReveal from "../components/react/DateReveal";
import Hero from "../components/sections/Hero.astro";
import Countdown from "../components/sections/Countdown.astro";
import SiteNav from "../components/sections/SiteNav.astro";
import FeatureBanner from "../components/sections/FeatureBanner.astro";

const pages = [
  {
    label: "Travel & Accommodation",
    href: "/travel",
    note: "Getting there & where to stay",
    icon: `<path d="M17.8 19.2 16 11l3.5-3.5a2.1 2.1 0 0 0-3-3L13 8 4.8 6.2a.5.5 0 0 0-.5.8l3.9 3.9-2.3 2.3-1.9-.4a.5.5 0 0 0-.5.8l2 2 2 2a.5.5 0 0 0 .8-.5l-.4-1.9 2.3-2.3 3.9 3.9a.5.5 0 0 0 .8-.5Z"/>`,
  },
  {
    label: "Explore Morocco",
    href: "/explore",
    note: "Our favourite places & tips",
    icon: `<circle cx="12" cy="12" r="9"/><polygon points="15.6 8.4 10.6 10.6 8.4 15.6 13.4 13.4"/>`,
  },
  {
    label: "Schedule of Events",
    href: "/schedule",
    note: "Our wedding weekend, day by day",
    icon: `<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 9.5h16"/><path d="M8.5 3v4"/><path d="M15.5 3v4"/>`,
  },
  {
    label: "Meet the Taros",
    href: "/the-taros",
    note: "Our story & wedding party",
    icon: `<circle cx="9.5" cy="13.5" r="5"/><circle cx="15" cy="11" r="5"/>`,
  },
  {
    label: "Registry",
    href: "/registry",
    note: "Gifts & wishes",
    icon: `<rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5.5 12v7.5a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V12"/><path d="M12 8v12.5"/><path d="M12 8C11 6 9 5.2 8 6.2 7 7.2 9 8.6 12 8Z"/><path d="M12 8c1-2 3-2.8 4-1.8 1 1-1 2.4-4 1.8Z"/>`,
  },
  {
    label: "Q&A",
    href: "/qa",
    note: "Everything you might be wondering",
    icon: `<path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.4 9 9 0 0 1-3.8-.8L3 21l1.9-5.7A8.4 8.4 0 0 1 4 11.5 8.5 8.5 0 0 1 12.5 3 8.5 8.5 0 0 1 21 11.5Z"/><path d="M9.9 9.2a2.2 2.2 0 0 1 4.2.7c0 1.5-2.1 1.9-2.1 1.9"/><circle cx="12" cy="15.2" r=".6"/>`,
  },
];
---

<BaseLayout>
  <img
    src="/assets/cherub.png"
    alt=""
    aria-hidden="true"
    class="cherub-float pointer-events-none fixed left-1/2 top-0 z-[55] w-28 md:w-36"
  />
  <div id="main-content" class="opacity-0" aria-hidden="true">
    <SiteNav heroTheme="light" />
    <Hero />
    <DateReveal client:load />
    <Countdown />
    <FeatureBanner
      header="Tayo & Ope"
      eyebrow="Marrakech · December 2026"
      title="Join us in Marrakech"
      text="Three days of culture, colour, and celebration in Marrakech. Your presence is the greatest gift of all."
      ctaLabel="View the Schedule"
      ctaHref="/schedule"
      leftImage="/images/hero.jpeg"
      rightImage="/pagesphotos/hotel/5b758b55.avif"
    />

    <!-- Explore the website · links to every page -->
    <section class="relative overflow-hidden bg-[#fffaf0] px-6 py-28">
      <div class="mx-auto max-w-5xl text-center">
        <p
          class="font-[family-name:var(--font-family-script)] text-4xl text-[var(--color-gold)] md:text-5xl"
        >
          Explore our website
        </p>
        <p
          class="mx-auto mt-6 max-w-2xl font-serif text-xl leading-relaxed text-[#5d574a]"
        >
          Here you'll find everything you need to plan your trip and enjoy the
          celebrations — travel and accommodation, the schedule of events, our
          story, and a few of our favourite things to experience while you're
          here.
        </p>

        <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            pages.map((page) => (
              <a
                href={page.href}
                class="group relative flex flex-col items-center rounded-[1.5rem] border border-[var(--color-gold)]/15 bg-white/60 px-8 py-12 text-center shadow-[0_18px_50px_rgba(90,50,26,0.08)] transition duration-500 hover:-translate-y-1.5 hover:border-[var(--color-gold)]/40 hover:bg-white hover:shadow-[0_26px_64px_rgba(90,50,26,0.14)]"
              >
                <span class="flex h-[74px] w-[74px] items-center justify-center rounded-full border border-[var(--color-gold)]/25 bg-[var(--color-gold)]/[0.06] transition duration-500 group-hover:scale-105 group-hover:border-[var(--color-gold)]/45 group-hover:bg-[var(--color-gold)]/[0.12]">
                  <svg
                    class="h-9 w-9 text-[var(--color-gold)]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <Fragment set:html={page.icon} />
                  </svg>
                </span>
                <h3 class="mt-7 font-serif text-2xl font-semibold leading-tight text-[var(--color-charcoal)]">
                  {page.label}
                </h3>
                <p class="mt-2 font-sans text-sm leading-relaxed text-[#5d574a]/75">
                  {page.note}
                </p>
                <span class="mt-5 inline-flex items-center gap-2 font-sans text-[10px] font-semibold uppercase tracking-[0.28em] text-[var(--color-gold)]">
                  View
                  <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <footer
      id="rsvp-panel"
      class="relative overflow-hidden bg-[#efe7d7] px-6 py-28 text-center text-[#3d3026]"
      data-section-title="RSVP"
    >
      <div class="footer-content relative z-10 mx-auto max-w-3xl opacity-0">
        <p
          class="font-sans text-[10px] font-semibold uppercase tracking-[0.42em] text-[var(--color-gold)]"
        >
          RSVP
        </p>
        <h2 class="mt-4 font-serif text-4xl font-semibold md:text-6xl">
          We hope you can make it
        </h2>
        <p
          class="mx-auto mt-6 max-w-xl font-serif text-xl leading-relaxed text-[#5d574a]"
        >
          Your presence means everything to us as we gather in Marrakesh for a
          week of celebration, culture, and love.
        </p>
        <a
          href="/rsvp"
          class="mt-10 inline-flex min-h-14 items-center justify-center rounded-full border border-[var(--color-gold)] bg-white/60 px-12 font-serif text-sm uppercase tracking-[0.22em] text-[#4b3926] shadow-[0_18px_50px_rgba(90,50,26,0.10)] transition duration-300 hover:-translate-y-0.5 hover:bg-white"
        >
          Send RSVP
        </a>
        <p
          class="mt-16 font-[family-name:var(--font-family-script)] text-5xl text-[var(--color-gold)] md:text-6xl"
        >
          Tayo + Ope
        </p>
        <p
          class="mt-3 font-sans text-[10px] uppercase tracking-[0.34em] text-[#5d574a]/60"
        >
          With love
        </p>
      </div>
    </footer>
  </div>
  <EnvelopeScreen client:load />
  <style>
    .cherub-float {
      animation: cherub-fly 5s ease-in-out infinite alternate;
      mix-blend-mode: multiply;
      opacity: 0.9;
    }
    @keyframes cherub-fly {
      0%   { transform: translateX(-50%) translateY(3vh); }
      100% { transform: translateX(-50%) translateY(80vh); }
    }
  </style>
  <script>
    import { playHeroIntro, initScrollAnimations } from "../scripts/animations";

    window.addEventListener(
      "envelope-opened",
      () => {
        playHeroIntro();
        requestAnimationFrame(() => {
          initScrollAnimations();
        });
      },
      { once: true },
    );
  </script>
</BaseLayout>
