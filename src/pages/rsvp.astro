---
import BaseLayout from '../layouts/BaseLayout.astro';
import RSVPForm from '../components/react/RSVPForm';
---

<BaseLayout title="RSVP — Tayo & Ope" description="RSVP for the wedding of Tayo & Ope in Marrakesh, Morocco.">
  <div class="flex min-h-screen flex-col items-center justify-center bg-[var(--color-blush)] px-4 py-20">
    <p class="font-[family-name:var(--font-family-script)] text-5xl text-[var(--color-gold)]">RSVP</p>
    <p class="mt-4 max-w-lg text-center font-serif text-lg text-gray-600">
      Please let us know if you&apos;ll be joining us for our special day.
    </p>
    <div class="mt-10 w-full max-w-lg">
      <RSVPForm client:load />
    </div>
    <a href="/" class="mt-8 text-sm text-gray-500 underline hover:text-gray-700">&larr; Back to invitation</a>
  </div>
</BaseLayout>
