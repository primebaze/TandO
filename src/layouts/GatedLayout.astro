---
import BaseLayout from "./BaseLayout.astro";
import SiteNav from "../components/sections/SiteNav.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";
import PasswordGate from "../components/react/PasswordGate";

interface Props {
  title?: string;
  description?: string;
  /** Render the shared SiteNav + SiteFooter. Pages with their own layout
   *  (e.g. /location) opt out and get only the password gate. */
  chrome?: boolean;
}

const { title, description, chrome = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  {/* Blocking check — hides content before paint if the visitor is locked out */}
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem("tothetaros_unlocked") !== "yes") {
          document.documentElement.classList.add("is-locked");
        }
      } catch (e) {}
    })();
  </script>

  <PasswordGate client:load />

  <div class="gated-content">
    {chrome && <SiteNav />}
    <slot />
    {chrome && <SiteFooter />}
  </div>

  {/* Smooth (Lenis) scrolling + GSAP scroll-triggered reveals */}
  <script>
    import { bootSmooth } from "../scripts/smooth";
    bootSmooth();
  </script>
</BaseLayout>
